{
  "rewrites": [
    { "source": "/", "destination": "/shukatsu-agent.html" },
    { "source": "/jikan", "destination": "/jikan-planner.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [ { "key": "Service-Worker-Allowed", "value": "/" }, { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/jikan-sw.js", "headers": [ { "key": "Service-Worker-Allowed", "value": "/jikan" }, { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
